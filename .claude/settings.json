{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "additionalDirectories": [
      "/home/user/DoublePlus",
      "/home/user/Abiogenesis"
    ],
    "deny": [
      "Edit(//home/user/DoublePlus/**)",
      "Edit(//home/user/Abiogenesis/**)",
      "Edit(/home/user/DoublePlus/**)",
      "Edit(/home/user/Abiogenesis/**)",
      "Edit(**/DoublePlus/**)",
      "Edit(**/Abiogenesis/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-reference-repos.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the reference repos are unchanged"
          }
        ]
      }
    ]
  }
}
